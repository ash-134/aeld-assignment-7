#! /bin/sh

case "$1" in
    start)
        echo "Loading LDD modules (scull, faulty, hello)..."
        /usr/bin/scull_load
        /usr/bin/module_load faulty
        modprobe hello
        ;;
    stop)
        echo "Unloading LDD modules..."
        rmmod hello
        /usr/bin/module_unload faulty
        /usr/bin/scull_unload
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
